VITE_FORMSPREE_ID=your_formspree_form_id

# Google reCAPTCHA v3 — site key (public, an toàn để lộ). Secret key KHÔNG đặt ở đây —
# secret key được hardcode trực tiếp trong google-apps-script/Code.gs (chỉ chủ sở hữu
# Apps Script mới xem được source, không public như bundle JS của site).
VITE_RECAPTCHA_SITE_KEY=

# Google Apps Script Web App URL — ghi dữ liệu đăng ký vào Google Sheet
# (2 sheet: "Đăng ký gian hàng" / "Đăng ký tài trợ"). Xem google-apps-script/README.md để lấy URL này.
VITE_APPS_SCRIPT_URL=

# Notion CMS — Doanh nghiệp triển lãm tiêu biểu (server-side only, KHÔNG thêm tiền tố VITE_)
NOTION_API_KEY=
NOTION_EXHIBITORS_DB_ID=30ea56db6c33498eb5e8163e7af4b38b
